# ======================================================================
# FUNAL / MYTAKIP ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# ======================================================================

# 1. Supabase Bulut Veritabanı Ayarları
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Birleşik E-Posta Gönderim Yapılandırması (SMTP veya Resend)
# EMAIL_ENABLED: 'false' (varsayılan pasif mod) veya 'true' (aktif e-posta gönderimi)
EMAIL_ENABLED=false
# EMAIL_PROVIDER: 'smtp' (varsayılan - Gmail vb.) veya 'resend' (özel domain ile)
EMAIL_PROVIDER=smtp
SENDER_NAME=Funal Bildirim
SENDER_EMAIL=funal.bildirim@gmail.com

# 3. SMTP Yapılandırması (Gmail 16 Haneli Uygulama Şifresi ile)
# Port 465 -> SSL/TLS | Port 587 -> STARTTLS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=funal.bildirim@gmail.com
SMTP_APP_PASSWORD=

# 4. Resend API (Opsiyonel - İleride özel doğrulanmış domain kullanıldığında)
RESEND_API_KEY=

# 5. Yönetici (Admin) Hata & Güvenlik Bildirim E-Postası (KVKK/Güvenlik)
ADMIN_EMAIL=admin@mytakip.local

# 6. Web Push Bildirimleri (VAPID Keys)
# Oluşturmak için: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:funal.bildirim@gmail.com

# 7. Canlı Uygulama Adresi
APP_URL=https://alperen-7.github.io/funal
